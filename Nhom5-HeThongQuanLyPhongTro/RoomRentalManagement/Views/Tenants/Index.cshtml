@model IEnumerable<RoomRentalManagement.Models.Tenant>

@{
    ViewData["Title"] = "Quản lý người thuê";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Danh sách người thuê</h1>
    <a asp-action="Create" class="btn btn-primary">Thêm người thuê</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<table class="table table-bordered table-striped align-middle">
    <thead>
        <tr>
            <th>Mã người thuê</th>
            <th>Họ tên</th>
            <th>Số điện thoại</th>
            <th>CCCD</th>
            <th>Ngày sinh</th>
            <th>Địa chỉ</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="7" class="text-center">Chưa có người thuê nào.</td></tr>
        }
        else
        {
            @foreach (var tenant in Model)
            {
                <tr>
                    <td>@tenant.TenantID</td>
                    <td>@tenant.FullName</td>
                    <td>@tenant.Phone</td>
                    <td>@tenant.CCCD</td>
                    <td>@(tenant.DateOfBirth?.ToString("dd/MM/yyyy") ?? "—")</td>
                    <td>@(string.IsNullOrWhiteSpace(tenant.Address) ? "—" : tenant.Address)</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@tenant.TenantID">Sửa</a> |
                        <a asp-action="Details" asp-route-id="@tenant.TenantID">Chi tiết</a> |
                        <a asp-action="Delete" asp-route-id="@tenant.TenantID">Xóa</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
