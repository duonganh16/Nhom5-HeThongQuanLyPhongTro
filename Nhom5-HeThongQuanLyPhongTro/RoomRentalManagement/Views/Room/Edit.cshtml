@model RoomRentalManagement.Models.Room

@{
    ViewData["Title"] = "Sửa phòng";
}

<h1>Sửa phòng</h1>

<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-action="Edit" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>

            <input type="hidden"
                   asp-for="RoomID" />

            <div class="form-group mb-3">
                <label asp-for="RoomName">
                    Tên phòng
                </label>

                <input asp-for="RoomName"
                       class="form-control" />

                <span asp-validation-for="RoomName"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Price">
                    Giá phòng
                </label>

                <input asp-for="Price"
                       class="form-control" />

                <span asp-validation-for="Price"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Area">
                    Diện tích
                </label>

                <input asp-for="Area"
                       class="form-control" />

                <span asp-validation-for="Area"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Status">
                    Trạng thái
                </label>

                <input asp-for="Status"
                       class="form-control" />

                <span asp-validation-for="Status"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description">
                    Mô tả
                </label>

                <textarea asp-for="Description"
                          class="form-control">
                </textarea>

                <span asp-validation-for="Description"
                      class="text-danger">
                </span>
            </div>

            <button type="submit"
                    class="btn btn-primary">
                Lưu thay đổi
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Quay lại
            </a>

        </form>

    </div>
</div>