@model RoomRentalManagement.Models.Room

@{
    ViewData["Title"] = "Thêm phòng";
}

<h1>Thêm phòng</h1>

<h4>Room</h4>
<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>

            <div class="form-group mb-3">
                <label asp-for="RoomName" class="control-label">
                    Tên phòng
                </label>

                <input asp-for="RoomName"
                       class="form-control" />

                <span asp-validation-for="RoomName"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Price" class="control-label">
                    Giá phòng
                </label>

                <input asp-for="Price"
                       class="form-control" />

                <span asp-validation-for="Price"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Area" class="control-label">
                    Diện tích
                </label>

                <input asp-for="Area"
                       class="form-control" />

                <span asp-validation-for="Area"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Status" class="control-label">
                    Trạng thái
                </label>

                <input asp-for="Status"
                       class="form-control" />

                <span asp-validation-for="Status"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label">
                    Mô tả
                </label>

                <textarea asp-for="Description"
                          class="form-control">
                </textarea>

                <span asp-validation-for="Description"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group">
                <input type="submit"
                       value="Thêm phòng"
                       class="btn btn-primary" />

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Quay lại
                </a>
            </div>

        </form>

    </div>
</div>