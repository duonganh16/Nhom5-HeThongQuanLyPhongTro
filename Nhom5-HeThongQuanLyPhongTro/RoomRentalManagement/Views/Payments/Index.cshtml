@model IEnumerable<RoomRentalManagement.Models.Payment>

@{
    ViewData["Title"] = "Quản lý thanh toán";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Quản lý thanh toán</h1>
    <a asp-action="Create" class="btn btn-primary">+ Ghi nhận thanh toán</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Mã thanh toán</th>
                <th>Hóa đơn</th>
                <th>Phòng</th>
                <th>Người thuê</th>
                <th>Ngày thanh toán</th>
                <th>Số tiền</th>
                <th>Phương thức</th>
                <th>Ghi chú</th>
                <th style="min-width: 190px;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="9" class="text-center text-muted py-4">Chưa có giao dịch thanh toán nào.</td></tr>
        }
        else
        {
            @foreach (var payment in Model)
            {
                <tr>
                    <td>@payment.PaymentID</td>
                    <td>
                        @if (payment.Invoice != null)
                        {
                            <a asp-controller="Invoices" asp-action="Details" asp-route-id="@payment.InvoiceID">#@payment.InvoiceID</a>
                            <div class="small text-muted">@payment.Invoice.BillingMonth.ToString("MM/yyyy")</div>
                        }
                        else
                        {
                            <span>#@payment.InvoiceID</span>
                        }
                    </td>
                    <td>@(payment.Invoice?.Contract?.Room?.RoomName ?? "—")</td>
                    <td>@(payment.Invoice?.Contract?.Tenant?.FullName ?? "—")</td>
                    <td>@payment.PaymentDate.ToString("dd/MM/yyyy")</td>
                    <td class="text-nowrap">@payment.Amount.ToString("N0") đ</td>
                    <td>@payment.PaymentMethod</td>
                    <td>@(string.IsNullOrWhiteSpace(payment.Note) ? "—" : payment.Note)</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@payment.PaymentID" class="btn btn-sm btn-outline-info">Chi tiết</a>
                        <a asp-action="Edit" asp-route-id="@payment.PaymentID" class="btn btn-sm btn-outline-primary">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@payment.PaymentID" class="btn btn-sm btn-outline-danger">Xóa</a>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>
