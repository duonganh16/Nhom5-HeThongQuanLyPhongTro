@model IEnumerable<RoomRentalManagement.Models.Invoice>

@{
    ViewData["Title"] = "Quản lý hóa đơn";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Danh sách hóa đơn</h1>
    <a asp-action="Create" class="btn btn-primary">Tạo hóa đơn</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="table-responsive">
    <table class="table table-bordered table-striped align-middle">
        <thead class="table-light">
            <tr>
                <th>Mã HĐ</th>
                <th>Tháng</th>
                <th>Phòng</th>
                <th>Người thuê</th>
                <th>Tiền thuê</th>
                <th>Điện</th>
                <th>Nước</th>
                <th>Phí dịch vụ</th>
                <th>Tổng tiền</th>
                <th>Trạng thái</th>
                <th style="min-width: 180px;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Any())
        {
            @foreach (var item in Model)
            {
                var electricUsage = item.ElectricNew - item.ElectricOld;
                var waterUsage = item.WaterNew - item.WaterOld;
                var statusLabel = item.Status switch
                {
                    "Paid" => "Đã thanh toán",
                    "Overdue" => "Quá hạn",
                    _ => "Chưa thanh toán"
                };
                var badgeClass = item.Status switch
                {
                    "Paid" => "bg-success",
                    "Overdue" => "bg-danger",
                    _ => "bg-warning text-dark"
                };
                <tr>
                    <td>@item.InvoiceID</td>
                    <td>@item.BillingMonth.ToString("MM/yyyy")</td>
                    <td>@(item.Contract?.Room?.RoomName ?? "-")</td>
                    <td>@(item.Contract?.Tenant?.FullName ?? "-")</td>
                    <td>@item.RentAmount.ToString("N0")</td>
                    <td>@electricUsage.ToString("N2")</td>
                    <td>@waterUsage.ToString("N2")</td>
                    <td>@item.ServiceFee.ToString("N0")</td>
                    <td><strong>@item.Total.ToString("N0")</strong></td>
                    <td><span class="badge @badgeClass">@statusLabel</span></td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.InvoiceID">Chi tiết</a> |
                        <a asp-action="Edit" asp-route-id="@item.InvoiceID">Sửa</a> |
                        <a asp-action="Delete" asp-route-id="@item.InvoiceID">Xóa</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="11" class="text-center">Chưa có hóa đơn nào.</td>
            </tr>
        }
        </tbody>
    </table>
</div>
