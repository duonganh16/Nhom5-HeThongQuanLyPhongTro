
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - RoomRentalManagement</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- CSS cua website -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <!-- CSS cua ASP.NET Core -->
    <link rel="stylesheet"
          href="~/RoomRentalManagement.styles.css"
          asp-append-version="true" />
</head>

<body>
    <!-- THANH DIEU HUONG -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm mb-3">
            <div class="container-fluid">

                <!-- Ten he thong -->
                <a class="navbar-brand fw-bold"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    RoomRentalManagement
                </a>

                <!-- Nut thu gon menu -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Mo menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Cac chuc nang -->
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto">

                        <!-- Trang chu -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                Trang chủ
                            </a>
                        </li>

                        <!-- Phong tro -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Rooms"
                               asp-action="Index">
                                Phòng trọ
                            </a>
                        </li>

                        <!-- Nguoi thue -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Tenants"
                               asp-action="Index">
                                Người thuê
                            </a>
                        </li>

                        <!-- Hop dong -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Contracts"
                               asp-action="Index">
                                Hợp đồng
                            </a>
                        </li>

                        <!-- Hoa don -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Invoices"
                               asp-action="Index">
                                Hóa đơn
                            </a>
                        </li>

                        <!-- Thanh toan -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Payments"
                               asp-action="Index">
                                Thanh toán
                            </a>
                        </li>

                        <!-- Yeu cau -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Requests"
                               asp-action="Index">
                                Yêu cầu
                            </a>
                        </li>

                        <!-- Privacy -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Privacy">
                                Privacy
                            </a>
                        </li>

                    </ul>

                    <!-- MENU TAI KHOAN -->
                    <ul class="navbar-nav ms-auto">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <span class="nav-link">
                                    Xin chào, @User.Identity.Name
                                    (@User.FindFirst(
                                        System.Security.Claims.ClaimTypes.Role
                                    )?.Value)
                                </span>
                            </li>

                            <li class="nav-item">
                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post"
                                      class="d-inline">

                                    <button type="submit"
                                            class="nav-link btn btn-link">
                                        Đăng xuất
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Đăng nhập
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Register">
                                    Đăng ký
                                </a>
                            </li>
                        }

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- NOI DUNG CAC TRANG -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- CHAN TRANG -->
    <footer class="border-top footer text-muted mt-4 py-3">
        <div class="container">
            &copy; @DateTime.Now.Year - RoomRentalManagement
            |
            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy">
                Privacy
            </a>
        </div>
    </footer>

    <!-- JAVASCRIPT -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
