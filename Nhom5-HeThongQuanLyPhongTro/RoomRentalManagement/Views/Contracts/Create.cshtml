@model RoomRentalManagement.Models.Contract
@{
    ViewData["Title"] = "Tạo hợp đồng";
}

<h1>Tạo hợp đồng thuê phòng</h1>
<hr />
<div class="row">
    <div class="col-md-7 col-lg-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="RoomID" class="form-label">Phòng trọ</label>
                <select asp-for="RoomID" asp-items="ViewBag.RoomID" class="form-select">
                    <option value="">-- Chọn phòng --</option>
                </select>
                <span asp-validation-for="RoomID" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TenantID" class="form-label">Người thuê</label>
                <select asp-for="TenantID" asp-items="ViewBag.TenantID" class="form-select">
                    <option value="">-- Chọn người thuê --</option>
                </select>
                <span asp-validation-for="TenantID" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="StartDate" class="form-label">Ngày bắt đầu</label>
                <input asp-for="StartDate" type="date" class="form-control" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EndDate" class="form-label">Ngày kết thúc (không bắt buộc)</label>
                <input asp-for="EndDate" type="date" class="form-control" />
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Deposit" class="form-label">Tiền đặt cọc (VNĐ)</label>
                <input asp-for="Deposit" type="number" min="0" step="1000" class="form-control" />
                <span asp-validation-for="Deposit" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="RentPrice" class="form-label">Giá thuê mỗi tháng (VNĐ)</label>
                <input asp-for="RentPrice" type="number" min="1" step="1000" class="form-control" />
                <span asp-validation-for="RentPrice" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Status" class="form-label">Trạng thái</label>
                <select asp-for="Status" class="form-select">
                    <option value="Active">Đang hiệu lực</option>
                    <option value="Expired">Đã hết hạn</option>
                    <option value="Terminated">Đã chấm dứt</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Lưu hợp đồng</button>
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
