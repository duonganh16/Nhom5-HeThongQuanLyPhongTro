@{
    ViewData["Title"] = "Tổng quan";
}

<style>
    .dashboard-welcome {
        margin-bottom: 26px;
    }

    .dashboard-welcome h2 {
        font-size: 25px;
        font-weight: 700;
        color: #172554;
        margin-bottom: 8px;
    }

    .dashboard-welcome p {
        color: #64748b;
        margin-bottom: 0;
    }

    .stat-card {
        height: 100%;
        padding: 22px;
        background: white;
        border: 1px solid #e8edf5;
        border-radius: 15px;
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.03);
    }

    .stat-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        margin-bottom: 18px;
    }

    .stat-label {
        color: #64748b;
        font-size: 14px;
    }

    .stat-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border-radius: 12px;
        font-size: 22px;
    }

    .icon-blue { background: #dbeafe; }
    .icon-green { background: #dcfce7; }
    .icon-orange { background: #ffedd5; }
    .icon-purple { background: #f3e8ff; }

    .stat-number {
        color: #172554;
        font-size: 30px;
        font-weight: 750;
        margin-bottom: 6px;
    }

    .stat-note {
        color: #64748b;
        font-size: 12px;
    }

    .panel {
        background: white;
        border: 1px solid #e8edf5;
        border-radius: 15px;
        padding: 22px;
        height: 100%;
    }

    .panel-title {
        color: #172554;
        font-size: 17px;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .panel-subtitle {
        color: #64748b;
        font-size: 13px;
        margin-bottom: 20px;
    }

    .room-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 15px 0;
        border-bottom: 1px solid #eef2f7;
    }

    .room-row:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .room-name {
        color: #1e293b;
        font-weight: 650;
        margin-bottom: 4px;
    }

    .room-meta {
        color: #64748b;
        font-size: 12px;
    }

    .status {
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 650;
        white-space: nowrap;
    }

    .status-rented {
        color: #15803d;
        background: #dcfce7;
    }

    .status-empty {
        color: #1d4ed8;
        background: #dbeafe;
    }

    .status-maintenance {
        color: #c2410c;
        background: #ffedd5;
    }

    .progress-track {
        width: 100%;
        height: 9px;
        overflow: hidden;
        background: #e2e8f0;
        border-radius: 20px;
    }

    .progress-fill {
        height: 100%;
        width: 75%;
        background: #2563eb;
        border-radius: 20px;
    }

    .quick-action {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px;
        color: #334155;
        text-decoration: none;
        border: 1px solid #e8edf5;
        border-radius: 12px;
        margin-bottom: 10px;
    }

    .quick-action:last-child {
        margin-bottom: 0;
    }

    .quick-action:hover {
        background: #f8fafc;
        color: #1d4ed8;
        border-color: #bfdbfe;
    }

    .quick-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: #eff6ff;
        font-size: 20px;
    }
</style>

<div class="dashboard-welcome">
    <h2>Xin chào, Quản lý! 👋</h2>
    <p>Đây là tình hình tổng quan của khu nhà trọ.</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <span class="stat-label">Tổng số phòng</span>
                <span class="stat-icon icon-blue">⌂</span>
            </div>
            <div class="stat-number">20</div>
            <div class="stat-note">Tổng số phòng trong khu trọ</div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <span class="stat-label">Phòng đang thuê</span>
                <span class="stat-icon icon-green">✓</span>
            </div>
            <div class="stat-number">15</div>
            <div class="stat-note">75% tổng số phòng</div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <span class="stat-label">Phòng còn trống</span>
                <span class="stat-icon icon-orange">⌂</span>
            </div>
            <div class="stat-number">4</div>
            <div class="stat-note">Có thể tiếp nhận người thuê</div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <span class="stat-label">Phòng bảo trì</span>
                <span class="stat-icon icon-purple">⚙</span>
            </div>
            <div class="stat-number">1</div>
            <div class="stat-note">Đang sửa chữa hoặc bảo trì</div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-xl-7">
        <section class="panel">
            <h3 class="panel-title">Tình trạng phòng</h3>
            <p class="panel-subtitle">Danh sách phòng minh họa</p>

            <div class="d-flex justify-content-between mb-2">
                <span class="text-secondary small">Tỷ lệ phòng đang thuê</span>
                <strong>75%</strong>
            </div>

            <div class="progress-track mb-3">
                <div class="progress-fill"></div>
            </div>

            <div class="room-row">
                <div>
                    <div class="room-name">Phòng P101</div>
                    <div class="room-meta">Tầng 1 · 2.500.000 đ/tháng</div>
                </div>
                <span class="status status-rented">Đang thuê</span>
            </div>

            <div class="room-row">
                <div>
                    <div class="room-name">Phòng P102</div>
                    <div class="room-meta">Tầng 1 · 2.200.000 đ/tháng</div>
                </div>
                <span class="status status-empty">Còn trống</span>
            </div>

            <div class="room-row">
                <div>
                    <div class="room-name">Phòng P201</div>
                    <div class="room-meta">Tầng 2 · 3.000.000 đ/tháng</div>
                </div>
                <span class="status status-rented">Đang thuê</span>
            </div>

            <div class="room-row">
                <div>
                    <div class="room-name">Phòng P202</div>
                    <div class="room-meta">Tầng 2 · Đang kiểm tra thiết bị</div>
                </div>
                <span class="status status-maintenance">Bảo trì</span>
            </div>
        </section>
    </div>

    <div class="col-12 col-xl-5">
        <section class="panel">
            <h3 class="panel-title">Thao tác nhanh</h3>
            <p class="panel-subtitle">Các công việc thường dùng</p>

            <a class="quick-action" href="#rooms">
                <span class="quick-icon">＋</span>
                <span>
                    <strong class="d-block">Quản lý phòng</strong>
                    <small class="text-secondary">Xem danh sách và trạng thái phòng</small>
                </span>
            </a>

            <a class="quick-action" href="#tenants">
                <span class="quick-icon">♙</span>
                <span>
                    <strong class="d-block">Người thuê</strong>
                    <small class="text-secondary">Theo dõi thông tin người thuê</small>
                </span>
            </a>

            <a class="quick-action" href="#contracts">
                <span class="quick-icon">▤</span>
                <span>
                    <strong class="d-block">Hợp đồng</strong>
                    <small class="text-secondary">Theo dõi hợp đồng thuê phòng</small>
                </span>
            </a>

            <a class="quick-action" href="#invoices">
                <span class="quick-icon">₫</span>
                <span>
                    <strong class="d-block">Hóa đơn</strong>
                    <small class="text-secondary">Theo dõi hóa đơn tiền phòng</small>
                </span>
            </a>
        </section>

        <section class="panel mt-3">
            <h3 class="panel-title">Lưu ý</h3>
            <p class="panel-subtitle mb-0">
                Các số liệu trên là dữ liệu mẫu phục vụ thiết kế giao diện,
                chưa được lấy từ cơ sở dữ liệu.
            </p>
        </section>
    </div>
</div>
