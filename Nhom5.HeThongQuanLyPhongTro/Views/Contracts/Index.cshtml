
@{
    ViewData["Title"] = "Quản lý hợp đồng";
}

<style>
    .contract-page {
        padding: 24px;
        color: #172554;
    }

    .contract-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 24px;
    }

    .contract-heading h2 {
        margin: 0 0 6px;
        font-size: 26px;
        font-weight: 800;
    }

    .contract-heading p {
        margin: 0;
        color: #64748b;
    }

    .contract-panel {
        padding: 20px;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        box-shadow: 0 4px 14px rgba(15, 23, 42, .04);
    }

    .contract-toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 20px;
    }

    .contract-toolbar input,
    .contract-toolbar select {
        min-height: 42px;
        padding: 8px 12px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
    }

    .contract-search {
        flex: 1;
        min-width: 220px;
    }

    .contract-table-wrap {
        overflow-x: auto;
    }

    .contract-table {
        width: 100%;
        border-collapse: collapse;
    }

    .contract-table th {
        padding: 14px 12px;
        background: #f1f5f9;
        color: #475569;
        font-size: 13px;
        text-align: left;
        white-space: nowrap;
    }

    .contract-table td {
        padding: 15px 12px;
        border-bottom: 1px solid #e2e8f0;
        font-size: 14px;
        font-weight: 500;
        white-space: nowrap;
    }

    .contract-table tbody tr:hover {
        background: #f8fafc;
    }

    .contract-status {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .contract-active {
        color: #166534;
        background: #dcfce7;
    }

    .contract-expiring {
        color: #92400e;
        background: #fef3c7;
    }

    .contract-ended {
        color: #475569;
        background: #e2e8f0;
    }

    .contract-btn {
        padding: 10px 15px;
        border: 0;
        border-radius: 8px;
        font-weight: 700;
        cursor: pointer;
    }

    .contract-btn-primary {
        color: white;
        background: #2563eb;
    }

    .contract-btn-primary:hover {
        background: #1d4ed8;
    }

    .contract-btn-light {
        color: #334155;
        background: #e2e8f0;
    }

    .contract-action {
        margin-right: 8px;
        padding: 0;
        border: 0;
        background: transparent;
        color: #2563eb;
        font-weight: 700;
        cursor: pointer;
    }

    .contract-action.delete {
        color: #dc2626;
    }

    .contract-empty {
        padding: 28px !important;
        color: #64748b;
        text-align: center;
    }

    .contract-modal {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 2000;
        align-items: center;
        justify-content: center;
        padding: 16px;
        background: rgba(15, 23, 42, .55);
    }

    .contract-modal.open {
        display: flex;
    }

    .contract-modal-content {
        width: 100%;
        max-width: 600px;
        max-height: 90vh;
        overflow-y: auto;
        padding: 24px;
        border-radius: 16px;
        background: white;
    }

    .contract-modal-content h3 {
        margin: 0 0 20px;
        font-weight: 800;
    }

    .contract-form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }

    .contract-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .contract-field.full {
        grid-column: 1 / -1;
    }

    .contract-field label {
        font-size: 13px;
        font-weight: 700;
    }

    .contract-field input,
    .contract-field select,
    .contract-field textarea {
        box-sizing: border-box;
        width: 100%;
        padding: 10px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
    }

    .contract-modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 22px;
    }

    @@media (max-width: 768px) {
        .contract-page {
            padding: 14px;
        }

        .contract-panel {
            padding: 12px;
        }

        .contract-form-grid {
            grid-template-columns: 1fr;
        }

        .contract-field.full {
            grid-column: auto;
        }
    }
</style>

<div class="contract-page">
    <div class="contract-heading">
        <div>
            <h2>Quản lý hợp đồng</h2>
            <p>Theo dõi thời hạn và trạng thái hợp đồng thuê phòng</p>
        </div>

        <button type="button"
                class="contract-btn contract-btn-primary"
                onclick="openContractModal()">
            + Thêm hợp đồng
        </button>
    </div>

    <div class="contract-panel">
        <div class="contract-toolbar">
            <input id="contractSearch"
                   class="contract-search"
                   type="search"
                   placeholder="Tìm mã hợp đồng, người thuê hoặc phòng..."
                   oninput="filterContracts()" />

            <select id="contractStatusFilter" onchange="filterContracts()">
                <option value="">Tất cả trạng thái</option>
                <option value="Đang hiệu lực">Đang hiệu lực</option>
                <option value="Sắp hết hạn">Sắp hết hạn</option>
                <option value="Đã kết thúc">Đã kết thúc</option>
            </select>
        </div>

        <div class="contract-table-wrap">
            <table class="contract-table">
                <thead>
                    <tr>
                        <th>Mã hợp đồng</th>
                        <th>Người thuê</th>
                        <th>Phòng</th>
                        <th>Ngày bắt đầu</th>
                        <th>Ngày kết thúc</th>
                        <th>Tiền cọc</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody id="contractTableBody"></tbody>
            </table>
        </div>
    </div>
</div>

<div id="contractModal" class="contract-modal">
    <div class="contract-modal-content">
        <h3 id="contractModalTitle">Thêm hợp đồng</h3>

        <form id="contractForm">
            <div class="contract-form-grid">
                <div class="contract-field">
                    <label for="contractCode">Mã hợp đồng *</label>
                    <input id="contractCode" required maxlength="20"
                           placeholder="VD: HD004" />
                </div>

                <div class="contract-field">
                    <label for="contractTenant">Người thuê *</label>
                    <input id="contractTenant" required maxlength="100"
                           placeholder="Nhập tên người thuê" />
                </div>

                <div class="contract-field">
                    <label for="contractRoom">Mã phòng *</label>
                    <input id="contractRoom" required maxlength="20"
                           placeholder="VD: P101" />
                </div>

                <div class="contract-field">
                    <label for="contractDeposit">Tiền cọc (VNĐ) *</label>
                    <input id="contractDeposit" type="number"
                           min="0" step="1000" required value="0" />
                </div>

                <div class="contract-field">
                    <label for="contractStart">Ngày bắt đầu *</label>
                    <input id="contractStart" type="date" required />
                </div>

                <div class="contract-field">
                    <label for="contractEnd">Ngày kết thúc *</label>
                    <input id="contractEnd" type="date" required />
                </div>

                <div class="contract-field full">
                    <label for="contractStatus">Trạng thái</label>
                    <select id="contractStatus">
                        <option value="Đang hiệu lực">Đang hiệu lực</option>
                        <option value="Sắp hết hạn">Sắp hết hạn</option>
                        <option value="Đã kết thúc">Đã kết thúc</option>
                    </select>
                </div>

                <div class="contract-field full">
                    <label for="contractNote">Ghi chú</label>
                    <textarea id="contractNote" rows="2"
                              maxlength="500"
                              placeholder="Thông tin bổ sung (nếu có)"></textarea>
                </div>
            </div>

            <div class="contract-modal-actions">
                <button type="button"
                        class="contract-btn contract-btn-light"
                        onclick="closeContractModal()">
                    Hủy
                </button>

                <button type="submit"
                        class="contract-btn contract-btn-primary">
                    Lưu hợp đồng
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    // Dữ liệu minh họa, chưa lấy từ database.
    let contracts = [
        {
            code: "HD001",
            tenant: "Nguyễn Văn An",
            room: "P101",
            start: "2026-01-01",
            end: "2026-12-31",
            deposit: 3000000,
            status: "Đang hiệu lực",
            note: ""
        },
        {
            code: "HD002",
            tenant: "Trần Thị Bình",
            room: "P201",
            start: "2026-02-01",
            end: "2026-10-31",
            deposit: 2500000,
            status: "Sắp hết hạn",
            note: ""
        },
        {
            code: "HD003",
            tenant: "Lê Văn Cường",
            room: "P102",
            start: "2025-01-01",
            end: "2025-12-31",
            deposit: 2000000,
            status: "Đã kết thúc",
            note: ""
        }
    ];

    let editingContractCode = null;

    function escapeContractHtml(value) {
        return String(value ?? "").replace(/[&<>"']/g, function (char) {
            return {
                "&": "&amp;",
                "<": "&lt;",
                ">": "&gt;",
                '"': "&quot;",
                "'": "&#39;"
            }[char];
        });
    }

    function formatContractDate(value) {
        if (!value) return "—";

        const parts = value.split("-");
        if (parts.length !== 3) return value;

        return parts[2] + "/" + parts[1] + "/" + parts[0];
    }

    function formatContractMoney(value) {
        return new Intl.NumberFormat("vi-VN").format(value) + " ₫";
    }

    function renderContracts() {
        const tbody = document.getElementById("contractTableBody");

        if (contracts.length === 0) {
            tbody.innerHTML =
                '<tr><td colspan="8" class="contract-empty">Chưa có dữ liệu hợp đồng</td></tr>';
            return;
        }

        tbody.innerHTML = contracts.map(function (contract) {
            let statusClass = "contract-active";

            if (contract.status === "Sắp hết hạn") {
                statusClass = "contract-expiring";
            } else if (contract.status === "Đã kết thúc") {
                statusClass = "contract-ended";
            }

            return `
                <tr>
                    <td><strong>${escapeContractHtml(contract.code)}</strong></td>
                    <td>${escapeContractHtml(contract.tenant)}</td>
                    <td>${escapeContractHtml(contract.room)}</td>
                    <td>${formatContractDate(contract.start)}</td>
                    <td>${formatContractDate(contract.end)}</td>
                    <td>${formatContractMoney(contract.deposit)}</td>
                    <td>
                        <span class="contract-status ${statusClass}">
                            ${escapeContractHtml(contract.status)}
                        </span>
                    </td>
                    <td>
                        <button type="button" class="contract-action"
                            onclick="editContract('${escapeContractHtml(contract.code)}')">
                            Sửa
                        </button>
                        <button type="button" class="contract-action delete"
                            onclick="deleteContract('${escapeContractHtml(contract.code)}')">
                            Xóa
                        </button>
                    </td>
                </tr>
            `;
        }).join("");

        filterContracts();
    }

    function filterContracts() {
        const keyword = document.getElementById("contractSearch")
            .value.trim().toLocaleLowerCase("vi");

        const status = document.getElementById("contractStatusFilter").value;

        document.querySelectorAll("#contractTableBody tr").forEach(function (row) {
            const text = row.textContent.toLocaleLowerCase("vi");
            const matchesKeyword = text.includes(keyword);
            const matchesStatus = !status ||
                row.querySelector(".contract-status")?.textContent.trim() === status;

            row.style.display = matchesKeyword && matchesStatus ? "" : "none";
        });
    }

    function openContractModal() {
        editingContractCode = null;
        document.getElementById("contractForm").reset();
        document.getElementById("contractCode").disabled = false;
        document.getElementById("contractDeposit").value = "0";
        document.getElementById("contractModalTitle").textContent = "Thêm hợp đồng";
        document.getElementById("contractModal").classList.add("open");
    }

    function closeContractModal() {
        document.getElementById("contractModal").classList.remove("open");
    }

    function editContract(code) {
        const contract = contracts.find(function (item) {
            return item.code === code;
        });

        if (!contract) return;

        editingContractCode = code;

        document.getElementById("contractModalTitle").textContent = "Sửa hợp đồng";
        document.getElementById("contractCode").value = contract.code;
        document.getElementById("contractCode").disabled = true;
        document.getElementById("contractTenant").value = contract.tenant;
        document.getElementById("contractRoom").value = contract.room;
        document.getElementById("contractDeposit").value = contract.deposit;
        document.getElementById("contractStart").value = contract.start;
        document.getElementById("contractEnd").value = contract.end;
        document.getElementById("contractStatus").value = contract.status;
        document.getElementById("contractNote").value = contract.note || "";
        document.getElementById("contractModal").classList.add("open");
    }

    function deleteContract(code) {
        const contract = contracts.find(function (item) {
            return item.code === code;
        });

        if (!contract) return;

        if (!confirm("Bạn có chắc muốn xóa hợp đồng " + contract.code + "?")) {
            return;
        }

        contracts = contracts.filter(function (item) {
            return item.code !== code;
        });

        renderContracts();
    }

    document.getElementById("contractForm").addEventListener("submit", function (event) {
        event.preventDefault();

        const contract = {
            code: document.getElementById("contractCode").value.trim(),
            tenant: document.getElementById("contractTenant").value.trim(),
            room: document.getElementById("contractRoom").value.trim(),
            deposit: Number(document.getElementById("contractDeposit").value),
            start: document.getElementById("contractStart").value,
            end: document.getElementById("contractEnd").value,
            status: document.getElementById("contractStatus").value,
            note: document.getElementById("contractNote").value.trim()
        };

        if (!contract.code || !contract.tenant || !contract.room ||
            !contract.start || !contract.end) {
            alert("Vui lòng nhập đầy đủ các trường bắt buộc.");
            return;
        }

        if (contract.deposit < 0 || !Number.isFinite(contract.deposit)) {
            alert("Tiền cọc phải là số không âm.");
            return;
        }

        if (contract.end < contract.start) {
            alert("Ngày kết thúc không được trước ngày bắt đầu.");
            return;
        }

        const duplicate = contracts.some(function (item) {
            return item.code.toLowerCase() === contract.code.toLowerCase()
                && item.code !== editingContractCode;
        });

        if (duplicate) {
            alert("Mã hợp đồng đã tồn tại. Vui lòng nhập mã khác.");
            return;
        }

        if (editingContractCode) {
            const index = contracts.findIndex(function (item) {
                return item.code === editingContractCode;
            });

            if (index !== -1) {
                contracts[index] = contract;
            }
        } else {
            contracts.push(contract);
        }

        closeContractModal();
        renderContracts();
    });

    document.getElementById("contractModal").addEventListener("click", function (event) {
        if (event.target === this) {
            closeContractModal();
        }
    });

    renderContracts();
</script>
