
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng nhập - Nhà Trọ 5</title>

    <style>
        * { box-sizing: border-box; }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            font-family: "Segoe UI", sans-serif;
            background: linear-gradient(135deg, #172554, #3b82f6);
        }

        .login-card {
            width: 100%;
            max-width: 420px;
            padding: 35px;
            border-radius: 20px;
            background: white;
            box-shadow: 0 15px 45px #0f172a40;
        }

        .brand {
            color: #1d4ed8;
            font-size: 26px;
            font-weight: 800;
            text-align: center;
        }

        .subtitle {
            color: #64748b;
            text-align: center;
            margin-bottom: 28px;
        }

        label {
            display: block;
            margin: 15px 0 7px;
            font-weight: 600;
        }

        input {
            width: 100%;
            padding: 12px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            font-size: 15px;
        }

        input:focus {
            outline: 2px solid #93c5fd;
            border-color: #2563eb;
        }

        .remember {
            display: flex;
            align-items: center;
            gap: 8px;
            margin: 16px 0;
        }

        .remember input { width: auto; }

        button {
            width: 100%;
            padding: 13px;
            border: 0;
            border-radius: 8px;
            background: #2563eb;
            color: white;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
        }

        button:hover { background: #1d4ed8; }

        .links {
            margin-top: 22px;
            text-align: center;
            line-height: 2;
        }

        a { color: #2563eb; }
    </style>
</head>
<body>
    <main class="login-card">
        <div class="brand">⌂ NHÀ TRỌ 5</div>
        <p class="subtitle">Hệ thống quản lý phòng trọ</p>

        <h2 style="text-align:center">Đăng nhập</h2>

        <form>
            <label for="email">Email</label>
            <input id="email" name="email" type="email"
                   placeholder="Nhập email của bạn" required />

            <label for="password">Mật khẩu</label>
            <input id="password" name="password" type="password"
                   placeholder="Nhập mật khẩu" required />

            <div class="remember">
                <input id="remember" name="remember"
                       type="checkbox" />
                <label for="remember" style="margin:0">
                    Ghi nhớ đăng nhập
                </label>
            </div>

            <button type="submit">Đăng nhập</button>
        </form>

        <div class="links">
            Chưa có tài khoản?
            <a href="/Account/Register">Đăng ký ngay</a>
            <br />
            <a href="/">Quay về trang chủ</a>
        </div>
    </main>
</body>
</html>
